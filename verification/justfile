image_name := "massively-verification:lean-4.32.0"

default:
    @just --list

# Build the shared pinned Lean verification environment.
image:
    docker build --tag {{ image_name }} .

# Check the proof with the host Lean installation.
proof-local:
    cd proof && lake build

# Check every definition and theorem in the pinned Docker environment.
proof: image
    docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp -v "$PWD:/workspace" -w /workspace/proof {{ image_name }} lake build

# Compare Massively's public vector and segment operations with CPU references.
oracle:
    cargo nextest run -p oracle

# Compare all graph algorithms with their independent CPU references.
algorithms:
    cargo nextest run -p graph-algorithms --test oracle --test essentials

# Benchmark the graph algorithms.
bench-graph:
    cargo bench -p graph-algorithms --bench algorithms

# Check the proof and both implementation comparisons.
check: proof oracle algorithms
